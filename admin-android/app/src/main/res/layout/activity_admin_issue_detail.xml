<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorCanvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorCanvas"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/colorCharcoal"
            app:title="Ticket Details"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:titleTextColor="@color/colorCharcoal" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshDetail"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Status Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTicketNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-semibold"
                            android:text="TICKET #HD-8819"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvPriorityBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_rounded"
                            android:backgroundTint="@color/colorUrgentLight"
                            android:fontFamily="sans-serif-semibold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="HIGH"
                            android:textColor="@color/colorUrgent"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_tag_rounded"
                            android:backgroundTint="@color/colorSageLight"
                            android:fontFamily="sans-serif-semibold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="SUBMITTED"
                            android:textColor="@color/colorSage"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvIssueTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="serif"
                        android:text="Continuous washbasin tap leakage"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Meta: Category, Location, Date -->
                    <TextView
                        android:id="@+id/tvIssueMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Issue details · Reported"
                        android:textColor="@color/colorSoftText"
                        android:textSize="13sp" />

                    <!-- Description Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/colorCard"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/colorBorder"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-semibold"
                                android:text="Problem Description"
                                android:textColor="@color/colorCharcoal"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:lineSpacingExtra="4dp"
                                android:text="Detailed description"
                                android:textColor="@color/colorCharcoal"
                                android:textSize="14sp" />

                            <!-- Initial Photo Attached by Resident -->
                            <ImageView
                                android:id="@+id/ivInitialPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                android:layout_marginTop="12dp"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Resident Details Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/colorCard"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/colorBorder"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-semibold"
                                android:text="Resident Information"
                                android:textColor="@color/colorCharcoal"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvResidentName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Resident: Campus Student"
                                android:textColor="@color/colorCharcoal"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvResidentContact"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Room · Contact info"
                                android:textColor="@color/colorMutedText"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Assignment Details & Action Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAssignedStaff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/colorCard"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/colorBorder"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvStaffAvatar"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_circle_primary"
                                    android:backgroundTint="@color/colorPrimaryContainer"
                                    android:gravity="center"
                                    android:text="T"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvStaffName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Assignment Status"
                                        android:textColor="@color/colorCharcoal"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvStaffContact"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Department / Technician"
                                        android:textColor="@color/colorMutedText"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Warden Assign/Reassign Action -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAssignOrReassign"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="12dp"
                                android:text="Assign Technician"
                                android:textColor="@color/colorPrimary"
                                app:cornerRadius="8dp"
                                app:strokeColor="@color/colorPrimary" />

                            <!-- Staff Work Actions -->
                            <LinearLayout
                                android:id="@+id/layoutStaffActions"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnStartWork"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:backgroundTint="@color/colorProgress"
                                    android:text="Start Work on Ticket"
                                    android:textColor="@color/white"
                                    android:visibility="gone"
                                    app:cornerRadius="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCompleteWork"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:backgroundTint="@color/colorSage"
                                    android:text="Mark Fixed &amp; Complete"
                                    android:textColor="@color/white"
                                    android:visibility="gone"
                                    app:cornerRadius="8dp" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Resolution Proof Card (if resolved) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardResolutionInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/colorCard"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/colorBorder"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-semibold"
                                android:text="Resolution Proof &amp; Notes"
                                android:textColor="@color/colorSage"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvResolutionNotes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Technician notes"
                                android:textColor="@color/colorCharcoal"
                                android:textSize="13sp" />

                            <ImageView
                                android:id="@+id/ivResolutionProof"
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                android:layout_marginTop="10dp"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Reopened by Resident Alert Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardReopenAlert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="#FDF2F2"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#F8B4B4"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-semibold"
                                android:text="⚠️ Work Unsatisfactory — Case Reopened"
                                android:textColor="#9B1C1C"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvReopenReason"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Resident indicated work is incomplete or unsatisfactory."
                                android:textColor="#771D1D"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Resident Verification & Review Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStudentFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="#FBF7ED"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#E2D4B7"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-semibold"
                                    android:text="Resident Work Verification"
                                    android:textColor="#8F5E14"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvResidentRatingStars"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="★★★★★"
                                    android:textColor="#D97706"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvResidentReviewText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="&quot;Work verified and completed well.&quot;"
                                android:textColor="@color/colorCharcoal"
                                android:textSize="13sp"
                                android:textStyle="italic" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Activity Timeline -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-semibold"
                        android:text="Audit Trail &amp; Timeline"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="15sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTimeline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>