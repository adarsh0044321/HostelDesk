# ========================================================
# HostelDesk Environment Configuration Template
# Copy this file to .env and configure for your local/cloud setup:
#   cp .env.example .env
# NEVER commit real credentials, passwords, or tokens to version control.
# ========================================================

# Server Port (Default: 8080)
PORT=8080

# Spring Active Profile: 'postgres' (production/cloud) or 'dev' / 'test' (embedded H2)
SPRING_PROFILES_ACTIVE=postgres

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/hosteldesk
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password

# JWT Secret Key (HMAC-SHA256, minimum 256 bits / 32 characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Python FastAPI AI Microservice URL
AI_SERVICE_URL=http://localhost:8000

# File Upload Storage Directory
UPLOAD_DIR=./uploads
